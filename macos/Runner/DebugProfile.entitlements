<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	App Sandbox is disabled: the Mikan BT source spawns an external `rqbit`
	sidecar process (see lib/data/torrent/rqbit_engine.dart) via
	Process.start(). Under App Sandbox, exec() of any binary outside the
	app bundle (e.g. a Homebrew-installed tool on PATH) is denied at the
	syscall level with "Operation not permitted" (errno 1), regardless of
	entitlements -- there is no public entitlement that allows spawning
	arbitrary external executables while keeping the sandbox on. This app
	was never intended for Mac App Store distribution, so sandboxing was
	never a hard requirement; it was only ever the Flutter template default.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
